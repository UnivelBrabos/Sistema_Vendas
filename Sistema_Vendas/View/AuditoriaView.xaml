<UserControl x:Class="Sistema_Vendas.View.AuditoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Sistema_Vendas.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid x:Name="grdContAuditoria" Background="#FFF0F0F0" Visibility="Visible">
            <Grid Name="grdTabelaVendas" HorizontalAlignment="Left" VerticalAlignment="Center" Width="565" Height="636" Margin="481,0,0,0"/>
            <Rectangle x:Name="retIdVenda" HorizontalAlignment="Left" Height="61" Margin="140,15,0,0" VerticalAlignment="Top" Width="361" Fill="White" RadiusX="10" RadiusY="10"/>
            <Label x:Name="lblIdVenda" Content="ID. Venda" HorizontalAlignment="Left" Margin="29,30,0,0" VerticalAlignment="Top" FontSize="18" FontFamily="Rockwell" HorizontalContentAlignment="Center"/>
            <TextBox x:Name="txtIdVenda" HorizontalAlignment="Left" Margin="153,32,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="334" FontSize="18" FontFamily="Rockwell" Background="{x:Null}" BorderBrush="{x:Null}" Height="27" VerticalContentAlignment="Center" PreviewTextInput="txtIdVenda_PreviewTextInput"/>
            <Label x:Name="lblVendedor" Content="Vendedor" HorizontalAlignment="Left" Margin="29,130,0,0" VerticalAlignment="Top" FontSize="18" FontFamily="Rockwell" HorizontalContentAlignment="Center" IsEnabled="False"/>
            <Rectangle x:Name="retVendedor" HorizontalAlignment="Left" Height="61" Margin="141,115,0,0" VerticalAlignment="Top" Width="360" Fill="White" RadiusX="10" RadiusY="10" IsEnabled="False"/>
            <TextBox x:Name="txtVendedor" HorizontalAlignment="Left" Margin="153,132,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="334" FontSize="18" FontFamily="Rockwell" Background="{x:Null}" BorderBrush="{x:Null}" Height="27" VerticalContentAlignment="Center" PreviewTextInput="txtIdVenda_PreviewTextInput" IsEnabled="False"/>
            <Label x:Name="lblCliente" Content="Cliente" HorizontalAlignment="Left" Margin="30,231,0,0" VerticalAlignment="Top" FontSize="18" FontFamily="Rockwell" Width="93" HorizontalContentAlignment="Center" IsEnabled="False"/>
            <Rectangle x:Name="retCliente" HorizontalAlignment="Left" Height="61" Margin="141,216,0,0" VerticalAlignment="Top" Width="360" Fill="White" RadiusX="10" RadiusY="10"/>
            <TextBox x:Name="txtCliente" HorizontalAlignment="Left" Margin="153,233,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="334" FontSize="18" FontFamily="Rockwell" Background="{x:Null}" BorderBrush="{x:Null}" Height="27" VerticalContentAlignment="Center" PreviewTextInput="txtIdVenda_PreviewTextInput" IsEnabled="False"/>
            <Label x:Name="lblValorTotal" Content="Valor Total" HorizontalAlignment="Left" Margin="22,333,0,0" VerticalAlignment="Top" FontSize="18" FontFamily="Rockwell" Width="108" HorizontalContentAlignment="Center" IsEnabled="False"/>
            <Rectangle x:Name="retValorTotal" HorizontalAlignment="Left" Height="61" Margin="142,318,0,0" VerticalAlignment="Top" Width="118" Fill="White" RadiusX="10" RadiusY="10"/>
            <TextBox x:Name="txtValorTotal" HorizontalAlignment="Left" Margin="154,335,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="94" FontSize="18" FontFamily="Rockwell" Background="{x:Null}" BorderBrush="{x:Null}" Height="27" VerticalContentAlignment="Center" PreviewTextInput="txtIdVenda_PreviewTextInput" IsEnabled="False"/>
            <Label x:Name="lblDataVenda" Content="Data Venda" HorizontalAlignment="Left" Margin="268,333,0,0" VerticalAlignment="Top" FontSize="18" FontFamily="Rockwell" Width="106" HorizontalContentAlignment="Center" IsEnabled="False"/>
            <Rectangle x:Name="retDataVenda" HorizontalAlignment="Left" Height="61" Margin="381,320,0,0" VerticalAlignment="Top" Width="120" Fill="White" RadiusX="10" RadiusY="10"/>
            <TextBox x:Name="txtDataVenda" HorizontalAlignment="Left" Margin="393,337,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="97" FontSize="18" FontFamily="Rockwell" Background="{x:Null}" BorderBrush="{x:Null}" Height="27" VerticalContentAlignment="Center" PreviewTextInput="txtIdVenda_PreviewTextInput" IsEnabled="False"/>
            <Button x:Name="btnBuscarItensVenda" Content="Buscar Itens" HorizontalAlignment="Left" Margin="22,422,0,0" Width="131" FontFamily="Rockwell" FontSize="18" Background="{x:Null}" Height="44" VerticalAlignment="Top" HorizontalContentAlignment="Center" BorderBrush="#FF73B8DA" IsEnabled="False">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="btnSalvar" Content="Salvar" HorizontalAlignment="Left" Margin="28,0,0,10" Width="131" FontFamily="Rockwell" FontSize="18" Background="#FF73DA84" Height="44" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" IsEnabled="False">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="btnExcluir" Content="Excluir" HorizontalAlignment="Left" Margin="368,0,0,16" Width="131" FontFamily="Rockwell" FontSize="18" Background="#FFDA7373" Height="44" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" IsEnabled="False">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Grid x:Name="grdAuxiliar" Margin="523,0,13,0">
                <DataGrid x:Name="dgvAuxiliar" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,42,0,15" Background="White" FontFamily="Rockwell" HeadersVisibility="Column" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn/>
                    </DataGrid.Columns>
                </DataGrid>
                <Label x:Name="lblAuxiliar" Content="Label" HorizontalAlignment="Center" Margin="0,4,0,0" VerticalAlignment="Top" FontFamily="Rockwell" FontSize="20"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
