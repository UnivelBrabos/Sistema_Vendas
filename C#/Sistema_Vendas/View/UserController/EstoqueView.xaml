<UserControl x:Class="Spark.View.EstoqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Sistema_Vendas.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="grdPrincipal" Background="#FFF0F0F0">
        <DataGrid x:Name="dgvAuxiliar" Margin="400,12,10,8" Background="White" FontFamily="Rockwell" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" IsReadOnly="True"/>
        <Rectangle x:Name="retIdProduto" HorizontalAlignment="Left" Height="61" Margin="10,12,0,0" VerticalAlignment="Top" Width="353" Fill="White" RadiusX="10" RadiusY="10"/>
        <TextBox x:Name="txtIdProduto" HorizontalAlignment="Left" Margin="22,29,0,0" TextWrapping="Wrap" Text="Id. Produto" VerticalAlignment="Top" Width="328" FontSize="18" FontFamily="Rockwell" Background="{x:Null}" BorderBrush="{x:Null}" Height="27" VerticalContentAlignment="Center" PreviewTextInput="txtIdProduto_PreviewTextInput" Tag="IdVenda" KeyDown="txtIdProduto_KeyDown" GotFocus="txtIdProduto_GotFocus"/>
        <Button x:Name="btnAtualizarEstoque" Content="Atualizar Estoque" HorizontalAlignment="Left" Margin="10,0,0,10" Width="164" FontFamily="Rockwell" FontSize="18" Background="#FF73DA84" Height="44" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" IsEnabled="True" Click="btnAtualizarEstoque_Click">
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Rectangle x:Name="retVlrEstoque" HorizontalAlignment="Left" Height="61" Margin="10,96,0,0" VerticalAlignment="Top" Width="164" Fill="White" RadiusX="10" RadiusY="10"/>
        <TextBox x:Name="txtValorEstoque" HorizontalAlignment="Left" Margin="22,113,0,0" TextWrapping="Wrap" Text="Estoque" VerticalAlignment="Top" Width="139" FontSize="18" FontFamily="Rockwell" Background="{x:Null}" BorderBrush="{x:Null}" Height="27" VerticalContentAlignment="Center" PreviewTextInput="txtValorEstoque_PreviewTextInput" Tag="IdVenda" GotFocus="txtValorEstoque_GotFocus"/>
    </Grid>
</UserControl>
