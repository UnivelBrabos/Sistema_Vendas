<UserControl x:Name="uscFiltrar" x:Class="Sistema_Vendas.View.UserController.FiltrarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Sistema_Vendas.View.UserController"
             mc:Ignorable="d" 
             d:DesignHeight="635" d:DesignWidth="1046">
    <Grid>
        <Grid Name="grdFiltrar" Background="White">
            <Label x:Name="lblFiltros" Content="Filtros&#xD;&#xA;" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.566,0.499" Width="104" HorizontalContentAlignment="Center" FontSize="22" FontFamily="Rockwell" Height="35"/>
            <DatePicker x:Name="dtpInicial" HorizontalAlignment="Left" Margin="243,63,0,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="#FF333333" BorderBrush="{x:Null}" FontFamily="Rockwell" Width="228" FontSize="20" Height="33" SelectedDateChanged="dtpInicial_SelectedDateChanged"/>
            <DatePicker x:Name="dtpFinal" HorizontalAlignment="Right" Margin="0,63,242,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="#FF333333" BorderBrush="{x:Null}" FontFamily="Rockwell" Width="229" Height="33" FontSize="20"/>
            <Label x:Name="lblAte" Content="Até" HorizontalAlignment="Center" Margin="0,63,0,0" VerticalAlignment="Top" HorizontalContentAlignment="Center" Width="104" FontSize="20" FontFamily="Rockwell"/>
            <Rectangle x:Name="retDiv1" Height="2" Margin="0,107,0,0" Stroke="Black" VerticalAlignment="Top" Width="797" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="-0.286"/>
                        <RotateTransform/>
                        <TranslateTransform X="-0.008"/>
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
            <TextBlock x:Name="txtVendedores" Margin="243,157,0,0" TextWrapping="Wrap" FontFamily="Rockwell" TextAlignment="Center" HorizontalAlignment="Left" Width="228" Height="29" VerticalAlignment="Top" FontSize="20"><Run Language="pt-br" Text="Vendedores"/></TextBlock>
            <Rectangle x:Name="retDiv2" Height="2" Margin="124,239,124,0" Stroke="Black" VerticalAlignment="Top" Width="797" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="-0.286"/>
                        <RotateTransform/>
                        <TranslateTransform X="-0.008"/>
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
            <TextBlock x:Name="txtClientes" Margin="243,295,0,0" TextWrapping="Wrap" FontFamily="Rockwell" TextAlignment="Center" HorizontalAlignment="Left" Width="228" Height="29" VerticalAlignment="Top" Text="Clientes" FontSize="20"/>
            <Rectangle x:Name="retDiv2_Copiar" Height="2" Margin="125,380,124,0" Stroke="Black" VerticalAlignment="Top" Width="797" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="-0.286"/>
                        <RotateTransform/>
                        <TranslateTransform X="-0.008"/>
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Button x:Name="btnFiltrar" Content="Filtrar" HorizontalAlignment="Left" Margin="126,0,0,19" Width="101" Background="#FF8DED88" BorderBrush="{x:Null}" FontFamily="Rockwell" Height="34" VerticalAlignment="Bottom" FontSize="20" Click="btnFiltrar_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="btnLimpar" Content="Limpar" HorizontalAlignment="Right" Margin="0,0,124,19" Width="101" Background="#FFED8888" BorderBrush="{x:Null}" FontFamily="Rockwell" Height="34" VerticalAlignment="Bottom" FontSize="20" Click="btnLimpar_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Rectangle x:Name="retVendedores" HorizontalAlignment="Left" Height="106" Margin="562,121,0,0" VerticalAlignment="Top" Width="255" RadiusX="10" RadiusY="10" Fill="#FFF9F9F9"/>
            <StackPanel x:Name="plnVendedores" Margin="575,124,0,0" Background="#FFF9F9F9" HorizontalAlignment="Left" Width="229" Height="99" VerticalAlignment="Top"/>
            <Rectangle x:Name="retClientes" HorizontalAlignment="Left" Height="106" Margin="562,261,0,0" VerticalAlignment="Top" Width="255" RadiusX="10" RadiusY="10" Fill="#FFF9F9F9"/>
            <StackPanel x:Name="plnClientes" Margin="575,264,0,0" Background="#FFF9F9F9" Height="99" VerticalAlignment="Top" HorizontalAlignment="Left" Width="229"/>
        </Grid>
    </Grid>
</UserControl>
