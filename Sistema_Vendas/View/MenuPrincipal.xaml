<Window xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Name="grdPrincipal" x:Class="Sistema_Vendas.View.MenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sistema_Vendas.View"
        WindowStartupLocation="CenterScreen"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Title="Menu Principal"
        mc:Ignorable="d"
        MinHeight="720"
        MinWidth="1240" HorizontalContentAlignment="Center"
        >

    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="679*"/>
            <ColumnDefinition Width="561*"/>
        </Grid.ColumnDefinitions>

        <Grid Name="grdMenuLateral" Background="#FF73B8DA" HorizontalAlignment="Left" Width="194">
            <Image Source="/Imagens/Vendas_Icon.png" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Top" Height="69" Width="122"/>

            <Grid Name="grdDashboard">
                <Image x:Name="imgDashboard" Margin="16,143,0,0" Source="/Imagens/Dashboard_Icon.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Height="35" Width="35"/>
                <Label x:Name="lblDashboard" Content="Dashboard" HorizontalAlignment="Left" Margin="59,148,0,0" VerticalAlignment="Top" Width="119" FontFamily="Rockwell" FontSize="14"/>

                <Grid Name="grdVisibilityDashboard" Visibility="Visible">
                    <Rectangle x:Name="retDashboard" Visibility="Hidden" HorizontalAlignment="Left" Height="36" Margin="0,143,0,0" Stroke="Black" VerticalAlignment="Top" Width="3" Fill="Black"/>
                    <Button x:Name="btnDashboard" HorizontalAlignment="Left" Margin="3,143,0,0" VerticalAlignment="Top" Width="191" Height="36" Background="Black" BorderBrush="{x:Null}" Opacity="0.0" Click="btnDashboard_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>

            <Grid Name="grdAuditoria">
                <Image Margin="16,233,0,0" Source="/Imagens/Auditoria_Icon.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Height="35" Width="35"/>
                <Label x:Name="lblAudiotoria" Content="Auditoria" HorizontalAlignment="Left" Margin="59,238,0,0" VerticalAlignment="Top" Width="119" FontFamily="Rockwell" FontSize="14"/>

                <Grid Name="grdVisibilityAuditoria" Visibility="Visible">
                    <Rectangle x:Name="retAuditoria" Visibility="Hidden" HorizontalAlignment="Left" Height="36" Margin="0,233,0,0" Stroke="Black" VerticalAlignment="Top" Width="3" Fill="Black"/>
                    <Button x:Name="btnAuditoria" HorizontalAlignment="Left" Margin="3,233,0,0" VerticalAlignment="Top" Width="191" Height="36" Background="Black" BorderBrush="Black"  Opacity="0.0" Click="btnAuditoria_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>

            <Grid Name="grdFuncionarios">
                <Image Margin="16,324,0,0" Source="/Imagens/Funcionarios_Icon.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Height="35" Width="35"/>
                <Label x:Name="lblFuncionarios" Content="Funcionários" HorizontalAlignment="Left" Margin="60,327.3,0,0" VerticalAlignment="Top" Width="118" FontFamily="Rockwell" FontSize="14"/>

                <Grid Name="grdVisibilityFuncionarios" Visibility="Visible">
                    <Rectangle x:Name="retFuncionarios" Visibility="Hidden" HorizontalAlignment="Left" Height="36" Margin="0,324,0,0" Stroke="Black" VerticalAlignment="Top" Width="3" Fill="Black"/>
                    <Button x:Name="btnFuncionarios" Background="Black" BorderBrush="Black" Opacity="0.0" HorizontalAlignment="Left" Margin="3,324,0,0" VerticalAlignment="Top" Width="191" Height="36" Click="btnFuncionarios_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>

            <Grid Name="grdEstoque">
                <Image Margin="16,415,0,0" Source="/Imagens/Estoque_Icon.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Height="35" Width="35"/>
                <Label x:Name="lblEstoque" Content="Estoque" HorizontalAlignment="Left" Margin="56,419,0,0" VerticalAlignment="Top" Width="118" FontFamily="Rockwell" FontSize="14"/>

                <Grid Name="grdVisibilityEstoque" Visibility="Visible">
                    <Rectangle x:Name="retEstoque" Visibility="Hidden" HorizontalAlignment="Left" Height="36" Margin="0,415,0,0" Stroke="Black" VerticalAlignment="Top" Width="3" Fill="Black"/>
                    <Button x:Name="btnEstoque" HorizontalAlignment="Left" Margin="3,415,0,0" VerticalAlignment="Top" Width="191" Height="36" Background="Black" BorderBrush="Black" Opacity="0.0" Click="btnEstoque_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>

            <Grid>
                <Image Margin="16,0,0,10" Source="/Imagens/Settings_Icon.png" Stretch="Fill" HorizontalAlignment="Left" Width="35" Height="35" VerticalAlignment="Bottom"/>
                <Grid Name="grdVisibilityConfiguracoes">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="682*"/>
                        <RowDefinition Height="23*"/>
                    </Grid.RowDefinitions>
                    <Button     x:Name="btnConfiguracoes"
                                HorizontalAlignment="Right"
                                Margin="0,0,142,10"
                                Width="35"
                                Background="Black"
                                BorderBrush="Black"
                                Opacity="0.0" Click="btnConfiguracoes_Click" Grid.RowSpan="2" Height="35" VerticalAlignment="Bottom" Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">

                                    <ContentPresenter   HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <Grid Name="grdConteudo" Margin="194,68,0,0" Grid.ColumnSpan="2">
            <Grid Name="grdContDashboard" Background="#FFF0F0F0" Visibility="Hidden">
                <Grid Name="grdDadosSimples" Margin="5,10,405,0" Height="72" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Elemento da Esquerda -->
                    <Grid Name="grdTotalVendas" Grid.Column="0" HorizontalAlignment="Left" Width="125">
                        <Rectangle Name="retTotalVendas" HorizontalAlignment="Left" Height="60" Margin="7,0,0,0" VerticalAlignment="Center" Width="101" Fill="White" RadiusX="10" RadiusY="10"/>
                        <Label Name="lblTotalVendas" Content="00000.00" Margin="54,30,24,0" VerticalAlignment="Top" FontSize="9" FontFamily="Rockwell" HorizontalContentAlignment="Center"/>
                        <Label Name="lblValorTotalVendas" Content="Total Vendas" HorizontalAlignment="Left" Margin="42,6,0,0" VerticalAlignment="Top" HorizontalContentAlignment="Center" Width="71" FontSize="9" FontFamily="Rockwell"/>
                        <Image Name="imgTotalVendas" Margin="12,0,0,0" Source="/Imagens/Venda_Icon.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Width="30" Height="30"/>
                    </Grid>

                    <!-- Elemento Central -->
                    <Grid Name="grdTotalRecebido" Grid.Column="1" HorizontalAlignment="Center" Width="129">
                        <Rectangle Name="retTotalRecebido" HorizontalAlignment="Left" Height="60" Margin="7,0,0,0" VerticalAlignment="Center" Width="101" Fill="White" RadiusX="10" RadiusY="10"/>
                        <Label Name="lblTotalRecebido" Content="00000.00" HorizontalAlignment="Left" Margin="49,30,0,0" VerticalAlignment="Top" FontSize="9" FontFamily="Rockwell" HorizontalContentAlignment="Center"/>
                        <Label Name="lblValorTotalRecebido" Content="Total Vendido" HorizontalAlignment="Left" Margin="37,6,0,0" VerticalAlignment="Top" HorizontalContentAlignment="Center" Width="71" FontSize="9" FontFamily="Rockwell"/>
                        <Image Name="imgTotalRecebido" Margin="12,0,0,0" Source="/Imagens/Dinheiro_Icon.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Width="30" Height="30"/>
                    </Grid>

                    <!-- Elemento da Direita -->
                    <Grid Name="grdMelhorCliente" Grid.Column="2" HorizontalAlignment="Right" Width="125">
                        <Rectangle Name="retMelhorCliente" Height="60" Margin="12,0,10,0" VerticalAlignment="Center" Fill="White" RadiusX="10" RadiusY="10"/>
                        <Label Name="lblMelhorCliente" Content="Mercado X" HorizontalAlignment="Left" Margin="49,30,0,0" VerticalAlignment="Top" FontSize="9" FontFamily="Rockwell" HorizontalContentAlignment="Center"/>
                        <Label Name="lblValorMelhorCliente" Content="Melhor Cliente" HorizontalAlignment="Left" Margin="41,6,0,0" VerticalAlignment="Top" HorizontalContentAlignment="Center" Width="74" FontSize="9" FontFamily="Rockwell"/>
                        <Image Name="imgMelhorCliente" Margin="12,0,0,0" Source="/Imagens/Cliente_Icon.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Width="30" Height="30"/>
                    </Grid>

                </Grid>

                <Grid Name="grdVendedores">
                    <Rectangle x:Name="RetVendedores" Height="303" Margin="0,16,10,0" RadiusX="20" RadiusY="20" VerticalAlignment="Top" Fill="White" HorizontalAlignment="Right" Width="387"/>
                    <lvc:PieChart x:Name="VendedoresChartControl" 
                              LegendLocation="Right"
                              InnerRadius="50"
                              Foreground="Black"
                              FontSize="14" 
                              DockPanel.Dock="Right" 
                              Margin="0,30,24,0" 
                              Background="White" 
                              HorizontalAlignment="Right" 
                              Width="358" 
                              Height="275" 
                              VerticalAlignment="Top"/>
                </Grid>

                <Grid Name ="grdVendaMensal">
                    <Rectangle Height="234" Margin="10,84,415,0" RadiusX="20" RadiusY="20" VerticalAlignment="Top" Fill="White"/>
                    <lvc:CartesianChart x:Name="VendasCharControl" Margin="22,95,425,0" 
                                Background="White"
                                Foreground="Black"
                                FontSize="14" 
                                Height="212" 
                                VerticalAlignment="Top"/>
                </Grid>

                <Grid Name="grdProdutosMaisVendidos" Margin="463,341,10,10">
                    <Rectangle RadiusX="20" RadiusY="20" Fill="White"/>
                    <lvc:CartesianChart x:Name="ProdutosCharControl" 
                                        Margin="10,10,10,10" 
                                        Background="White" 
                                        Foreground="Black" 
                                        FontSize="14">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Ano" LabelFormatter="{Binding Formatter}"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Produtos" Labels="{Binding LabelsY}" />
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>

                <Grid Name="grdMelhoresClientes" HorizontalAlignment="Left" Margin="10,341,0,10" Width="433">
                    <Rectangle x:Name="RetClientes" RadiusX="20" RadiusY="20" Fill="White"/>
                    <lvc:PieChart x:Name="ClientesChartControl" 
                                  LegendLocation="Right"
                                  InnerRadius="50"
                                  Foreground="Black"
                                  FontSize="14" 
                                  Background="White" Height="265" VerticalAlignment="Center" Margin="10,0,10,0"/>
                </Grid>
            </Grid>
            <Grid x:Name="grdContAuditoria" Background="#FFF0F0F0" Visibility="Hidden" HorizontalAlignment="Left" Width="1046">
                <Grid Name="grdTabelaVendas" HorizontalAlignment="Left" VerticalAlignment="Center" Width="565" Height="636" Margin="481,0,0,0">
                    <Rectangle x:Name="retDadosVendas" HorizontalAlignment="Center" Height="616" VerticalAlignment="Center" Width="545" Fill="White" RadiusX="10" RadiusY="10"/>
                    <DataGrid x:Name="dgvDadosVendas" d:ItemsSource="{d:SampleData ItemCount=5}" HorizontalAlignment="Center" VerticalAlignment="Center" Height="588" Width="545" Background="{x:Null}" BorderBrush="{x:Null}" MaxColumnWidth="150" GridLinesVisibility="Vertical" HeadersVisibility="Column"/>
                </Grid>
            </Grid>
        </Grid>

        <Rectangle Name="retDivisor" Margin="199,62,10,0" Stroke="Black" Height="1" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

        <Grid Name="MenuHorizontal" VerticalAlignment="Top" Height="68" Margin="194,0,0,0" Background="#FFF0F0F0" Grid.ColumnSpan="2">
            <Image x:Name="imgUsuario" Margin="0,10,10,0" Source="/Imagens/User_Icon.png" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Top" Width="45" Height="45"/>
            <Image x:Name="imgFiltros" Margin="10,10,0,0" Source="/Imagens/Filtro_Icon.png" Stretch="Fill" Height="45" VerticalAlignment="Top" HorizontalAlignment="Left" Width="45"/>
            <Button x:Name="btnUsuario" Margin="0,10,10,0" Background="Black" BorderBrush="Black" Opacity="0.0" Cursor="Hand" Height="45" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Click="btnUsuario_Click" HorizontalAlignment="Right" Width="45">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Label Content="João da Silva" Margin="706,0,60,0" VerticalAlignment="Center" FontFamily="Rockwell" FontSize="14" HorizontalContentAlignment="Right"/>
            <Button x:Name="btnFiltrar" Margin="10,10,0,0" Background="Black" BorderBrush="Black" Opacity="0.0" Cursor="Hand" RenderTransformOrigin="0.5,0.5" Click="btnFiltrar_Click" Height="45" VerticalAlignment="Top" HorizontalAlignment="Left" Width="45">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>