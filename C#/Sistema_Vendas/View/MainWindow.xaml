<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sistema_Vendas"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        x:Class="Sistema_Vendas.MainWindow"
        mc:Ignorable="d"
        Title="Spark" MinHeight="720" MinWidth="1080" Height="728">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="307*"/>
            <ColumnDefinition Width="53*"/>
        </Grid.ColumnDefinitions>
        <Rectangle x:Name="Ret_Menu" Fill="#FF81B6DF" Height="72" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

        <Grid x:Name="grdGraficos" Margin="31,72,0,0" Background="#FFF0F0F0" Grid.ColumnSpan="2">


            <Rectangle Height="304" Margin="10,10,404,0" RadiusX="20" RadiusY="20" VerticalAlignment="Top" Fill="White"/>
            <lvc:CartesianChart x:Name="VendasCharControl" Margin="22,24,415,0" 
                                Background="White"
                                Foreground="Black"
                                FontSize="14" 
                                Height="276" 
                                VerticalAlignment="Top"/>

            <Rectangle x:Name="RetClientes" Margin="0,326,10,10" RadiusX="20" RadiusY="20" Fill="White" HorizontalAlignment="Right" Width="373"/>
            <lvc:PieChart x:Name="ClientesChartControl" 
                          LegendLocation="Right"
                          InnerRadius="50"
                          Foreground="Black"
                          FontSize="14" 
                          DockPanel.Dock="Right" 
                          Margin="0,340,24,24" 
                          Background="White" 
                          HorizontalAlignment="Right" 
                          Width="345"/>

            <Rectangle Margin="343,326,404,10" RadiusX="20" RadiusY="20" Fill="White"/>
            <lvc:CartesianChart x:Name="ProdutosCharControl" 
                                Margin="356,369,415,24" 
                                Background="White" 
                                Foreground="Black" 
                                FontSize="14">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Title="Ano" LabelFormatter="{Binding Formatter}"/>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="Produtos" Labels="{Binding LabelsY}" />
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>


            <TextBlock x:Name="txtCompradores" Margin="0,325,90,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="16" Height="31" FontFamily="Rockwell" TextAlignment="Center" HorizontalAlignment="Right" Width="213"><Run Language="pt-br" Text="Maiores Compradores"/></TextBlock>
            <TextBlock x:Name="txtMelhoresVendedores" Margin="0,9,90,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="16" Height="31" FontFamily="Rockwell" TextAlignment="Center" HorizontalAlignment="Right" Width="213"><Run Language="pt-br" Text="Melhores Vendedores"/></TextBlock>
            <TextBlock x:Name="txtProdutos" Margin="418,331,480,0" TextWrapping="Wrap" FontSize="16" FontFamily="Rockwell" TextAlignment="Center" Height="25" VerticalAlignment="Top"><Run Language="pt-br" Text="Produtos mais vendidos"/></TextBlock>
            <TextBlock x:Name="txtVendasMensais" Margin="237,10,630,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="16" Height="31" FontFamily="Rockwell" TextAlignment="Center"><Run Language="pt-br" Text="Vendas mensais"/></TextBlock>
            <Rectangle Margin="10,326,0,10" RadiusX="20" RadiusY="20" Fill="White" HorizontalAlignment="Left" Width="315"/>
            <TextBlock x:Name="txtFiltros" Margin="80,331,0,0" TextWrapping="Wrap" FontSize="16" FontFamily="Rockwell" TextAlignment="Center" HorizontalAlignment="Left" Width="176" Height="19" VerticalAlignment="Top"><Run Language="pt-br" Text="Filtros"/><LineBreak/><Run Language="pt-br"/></TextBlock>
            <DatePicker x:Name="dtpInicial" HorizontalAlignment="Left" Margin="16,369,0,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="#FF333333" BorderBrush="{x:Null}" FontFamily="Rockwell" Width="122" SelectedDateChanged="dtpInicial_SelectedDateChanged"/>
            <TextBlock HorizontalAlignment="Left" Margin="158,374,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Rockwell" Width="19" Height="20"><Run Language="pt-br" Text="Até"/><LineBreak/><Run Language="pt-br"/></TextBlock>
            <DatePicker x:Name="dtpFinal" HorizontalAlignment="Left" Margin="197,369,0,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="#FF333333" BorderBrush="{x:Null}" FontFamily="Rockwell" Width="122"/>
            <Rectangle HorizontalAlignment="Left" Height="2" Margin="18,393,0,0" Stroke="Black" VerticalAlignment="Top" Width="298" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="-0.286"/>
                        <RotateTransform/>
                        <TranslateTransform X="-0.008"/>
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Button x:Name="btnFiltrar" Content="Filtrar" HorizontalAlignment="Left" Margin="34,0,0,19" Width="59" Background="#FF8DED88" BorderBrush="{x:Null}" FontFamily="Rockwell" Click="btnFiltrar_Click" Height="19" VerticalAlignment="Bottom">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="btnLimpar" Content="Limpar" HorizontalAlignment="Left" Margin="237,0,0,19" Width="59" Background="#FFED8888" BorderBrush="{x:Null}" FontFamily="Rockwell" Height="19" VerticalAlignment="Bottom" Click="btnLimpar_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <ComboBox x:Name="cmbVendedores"
                      HorizontalAlignment="Left"
                      Margin="111,444,0,0"
                      VerticalAlignment="Top"
                      Width="200"
                      ItemsSource="{Binding ItemscCheckBox}"
                      FontFamily="Rockwell" Background="{x:Null}" BorderBrush="{x:Null}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Rectangle HorizontalAlignment="Left" Height="2" Margin="18,480,0,0" Stroke="Black" VerticalAlignment="Top" Width="298" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="-0.286"/>
                        <RotateTransform/>
                        <TranslateTransform X="-0.008"/>
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
            <TextBlock x:Name="txtVendedores" Margin="22,447,0,0" TextWrapping="Wrap" FontFamily="Rockwell" TextAlignment="Center" HorizontalAlignment="Left" Width="73" Height="19" VerticalAlignment="Top"><Run Language="pt-br" Text="Vendedores"/></TextBlock>
            <TextBlock x:Name="txtClientes" Margin="22,531,0,0" TextWrapping="Wrap" FontFamily="Rockwell" TextAlignment="Center" HorizontalAlignment="Left" Width="73" Height="19" VerticalAlignment="Top" Text="Clientes"/>
            <ComboBox x:Name="cmbClientes"
                HorizontalAlignment="Left"
                Margin="111,530,0,0"
                VerticalAlignment="Top"
                Width="200"
                ItemsSource="{Binding ItemsClientesCheckBox}"
                FontFamily="Rockwell" Background="{x:Null}" BorderBrush="{x:Null}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Rectangle HorizontalAlignment="Left" Height="2" Margin="19,566,0,0" Stroke="Black" VerticalAlignment="Top" Width="298" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="-0.286"/>
                        <RotateTransform/>
                        <TranslateTransform X="-0.008"/>
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <Grid x:Name="grdAuditoria" Margin="0,72,0,0" Background="#FFF0F0F0" Grid.ColumnSpan="2" Visibility="Hidden">
            <DataGrid x:Name="dtgVendas" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="540,10,10,10" Background="#FFFDFDFD" FontFamily="Rockwell" FontSize="16" Cursor="Arrow" MaxColumnWidth="999" HorizontalGridLinesBrush="Black" HeadersVisibility="Column" SelectionUnit="Cell"/>
        </Grid>

        <Image Source="/Imagens/Vendas_Icon.png" Stretch="Fill" Height="72" VerticalAlignment="Top" HorizontalAlignment="Left" Width="136"/>
        <Button x:Name="btnAuditoria" Content="Auditoria" HorizontalAlignment="Left" Margin="342,18,0,0" VerticalAlignment="Top" Height="36" Width="100" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" FontFamily="Rockwell" FontSize="18" Click="btnAuditoria_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button x:Name="btnGraficos" Content="Analytics" HorizontalAlignment="Left" Margin="183,18,0,0" VerticalAlignment="Top" Height="36" Width="100" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" FontFamily="Rockwell" FontSize="18" Click="btnGraficos_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
