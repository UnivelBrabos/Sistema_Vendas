<UserControl x:Class="Sistema_Vendas.View.AuditoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Sistema_Vendas.View"
             mc:Ignorable="d">
    <Grid>
        <Grid x:Name="grdContAuditoria" Background="#FFF0F0F0" Visibility="Visible">
            <Grid Name="grdTabelaVendas" HorizontalAlignment="Left" VerticalAlignment="Center" Width="565" Height="636" Margin="481,0,0,0"/>
            <Rectangle x:Name="retIdVenda" HorizontalAlignment="Left" Height="61" Margin="31,18,0,0" VerticalAlignment="Top" Width="418" Fill="White" RadiusX="10" RadiusY="10"/>
            <TextBox x:Name="txtIdVenda" HorizontalAlignment="Left" Margin="44,35,0,0" TextWrapping="Wrap" Text="Id. Venda" VerticalAlignment="Top" Width="388" FontSize="18" FontFamily="Rockwell" Background="{x:Null}" BorderBrush="{x:Null}" Height="27" VerticalContentAlignment="Center" PreviewTextInput="txtIdVenda_PreviewTextInput" Tag="IdVenda" KeyDown="txtIdVenda_KeyDown" GotFocus="txtIdVenda_GotFocus" TextChanged="txtIdVenda_TextChanged"/>
            <Rectangle x:Name="retVendedor" HorizontalAlignment="Left" Height="61" Margin="32,118,0,0" VerticalAlignment="Top" Width="417" Fill="White" RadiusX="10" RadiusY="10" IsEnabled="False"/>
            <TextBox x:Name="txtVendedor" HorizontalAlignment="Left" Margin="44,135,0,0" TextWrapping="Wrap" Text="Vendedor" VerticalAlignment="Top" Width="388" FontSize="18" FontFamily="Rockwell" Background="{x:Null}" BorderBrush="{x:Null}" Height="27" VerticalContentAlignment="Center" PreviewTextInput="txtIdVenda_PreviewTextInput" IsEnabled="False" Tag="Vendedor" GotFocus="txtVendedor_GotFocus"/>
            <Rectangle x:Name="retCliente" HorizontalAlignment="Left" Height="61" Margin="32,219,0,0" VerticalAlignment="Top" Width="417" Fill="White" RadiusX="10" RadiusY="10"/>
            <TextBox x:Name="txtCliente" HorizontalAlignment="Left" Margin="44,236,0,0" TextWrapping="Wrap" Text="Cliente" VerticalAlignment="Top" Width="388" FontSize="18" FontFamily="Rockwell" Background="{x:Null}" BorderBrush="{x:Null}" Height="27" VerticalContentAlignment="Center" PreviewTextInput="txtIdVenda_PreviewTextInput" IsEnabled="False" Tag="Cliente" GotFocus="txtCliente_GotFocus"/>
            <Rectangle x:Name="retValorTotal" HorizontalAlignment="Left" Height="61" Margin="32,318,0,0" VerticalAlignment="Top" Width="130" Fill="White" RadiusX="10" RadiusY="10"/>
            <TextBox x:Name="txtValorTotal" HorizontalAlignment="Left" Margin="44,335,0,0" TextWrapping="Wrap" Text="Total Venda" VerticalAlignment="Top" Width="106" FontSize="18" FontFamily="Rockwell" Background="{x:Null}" BorderBrush="{x:Null}" Height="27" VerticalContentAlignment="Center" PreviewTextInput="txtIdVenda_PreviewTextInput" IsEnabled="False"/>
            <Rectangle x:Name="retDataVenda" HorizontalAlignment="Left" Height="61" Margin="176,318,0,0" VerticalAlignment="Top" Width="130" Fill="White" RadiusX="10" RadiusY="10"/>
            <TextBox x:Name="txtDataVenda" HorizontalAlignment="Left" Margin="189,335,0,0" TextWrapping="Wrap" Text="Data Venda" VerticalAlignment="Top" Width="117" FontSize="18" FontFamily="Rockwell" Background="{x:Null}" BorderBrush="{x:Null}" Height="27" VerticalContentAlignment="Center" PreviewTextInput="txtIdVenda_PreviewTextInput" IsEnabled="False"/>
            <Button x:Name="btnBuscarItensVenda" Content="Buscar Itens" HorizontalAlignment="Left" Margin="318,318,0,0" Width="131" FontFamily="Rockwell" FontSize="18" Background="#FF73B8DA" Height="61" VerticalAlignment="Top" HorizontalContentAlignment="Center" BorderBrush="#FF73B8DA" IsEnabled="False" Click="btnBuscarItensVenda_Click" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="10"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="btnSalvar" Content="Salvar" HorizontalAlignment="Left" Margin="32,0,0,10" Width="131" FontFamily="Rockwell" FontSize="18" Background="#FF73DA84" Height="44" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" IsEnabled="False" Click="btnSalvar_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="btnExcluir" Content="Excluir" HorizontalAlignment="Left" Margin="318,0,0,10" Width="131" FontFamily="Rockwell" FontSize="18" Background="#FFDA7373" Height="44" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" IsEnabled="False" Click="btnExcluir_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Grid x:Name="grdAuxiliar" Margin="481,0,13,0">
                <DataGrid x:Name="dgvAuxiliar" Margin="10,10,0,10" Background="White" FontFamily="Rockwell" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" IsReadOnly="True"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
